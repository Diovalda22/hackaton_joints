GAMBUTOPS_APP_ENV=development
GAMBUTOPS_DATABASE_URL=postgresql+psycopg://gambutops:gambutops@127.0.0.1:5433/gambutops
# Supabase deployment template: copy .env.supabase.example to .env, then provide the
# URL-encoded database password from Project Settings > Database.
GAMBUTOPS_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Development has deterministic demo tokens. Set strong, distinct values outside development/test.
GAMBUTOPS_COORDINATOR_TOKEN=
GAMBUTOPS_FIELD_OFFICER_TOKEN=
# NASA FIRMS key: server-side only. Local helper: scripts/configure_firms_key.py
GAMBUTOPS_FIRMS_MAP_KEY=

