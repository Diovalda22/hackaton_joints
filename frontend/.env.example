# Frontend berjalan tanpa variabel lingkungan: default memakai mock repository (data DEMO).

# Sumber data: "mock" (default) atau "rest". "rest" hanya aktif bila NEXT_PUBLIC_API_BASE_URL terisi.
# NEXT_PUBLIC_DATA_SOURCE=rest
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Jangan pernah menaruh FIRMS_MAP_KEY, DATABASE_URL, atau token auth di NEXT_PUBLIC_*.
# Semua nilai NEXT_PUBLIC_* ikut terkirim ke browser.
